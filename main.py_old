#!/usr/bin/env python3
"""
Скрипт для скачивания и проверки MTProto прокси
Поддерживает форматы: tg://proxy, t.me/proxy, ip:port, ip:port:secret
"""

import asyncio
import re
import sys
import time
from datetime import datetime
from urllib.parse import parse_qs, urlparse

import aiohttp

# ==================== НАСТРОЙКИ ====================
TIMEOUT = 5  # таймаут в секундах (3-5 секунд)
MAX_CONCURRENT = 30  # количество одновременных проверок

# ИСПРАВЛЕННЫЕ ИСТОЧНИКИ (все проверены)
SOURCES = [
    "https://raw.githubusercontent.com/SoliSpirit/mtproto/master/all_proxies.txt",
    "https://raw.githubusercontent.com/ALIILAPRO/MTProtoProxy/main/mtproto.txt",
    "https://raw.githubusercontent.com/Grim1313/mtproto-for-telegram/master/all_proxies.txt",  # правильный URL
]

# ==================== ФУНКЦИИ ====================


def parse_proxy(line):
    """
    Парсит строку прокси из разных форматов:
    - tg://proxy?server=1.2.3.4&port=443&secret=xxx
    - https://t.me/proxy?server=...&port=...&secret=...
    - ip:port
    - ip:port:secret
    """
    line = line.strip()
    if not line or line.startswith("#"):
        return None

    # Формат tg://proxy или https://t.me/proxy
    if "proxy?" in line and ("server=" in line or "port=" in line):
        # Извлекаем параметры из URL
        match = re.search(r"[?&](server|port|secret)=([^&]+)", line)
        params = {}
        for m in re.finditer(r"[?&](server|port|secret)=([^&]+)", line):
            params[m.group(1)] = m.group(2)

        if "server" in params and "port" in params:
            try:
                port = int(params["port"])
                secret = params.get("secret")
                # URL-декодирование secret (иногда бывает %3D и т.п.)
                if secret:
                    secret = secret.replace("%3D", "=").replace("%3d", "=")
                return {"server": params["server"], "port": port, "secret": secret}
            except ValueError:
                pass

    # Формат ip:port или ip:port:secret
    parts = line.split(":")
    if len(parts) >= 2:
        server = parts[0]
        try:
            port = int(parts[1])
            secret = parts[2] if len(parts) > 2 else None
            return {"server": server, "port": port, "secret": secret}
        except ValueError:
            return None

    return None


async def check_proxy_simple(proxy):
    """Проверяет прокси через TCP-соединение"""
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(proxy["server"], proxy["port"]), timeout=TIMEOUT
        )
        writer.close()
        await writer.wait_closed()
        return {"proxy": proxy, "status": "alive", "latency": TIMEOUT}
    except:
        return {"proxy": proxy, "status": "dead", "latency": None}


async def fetch_proxies(session, url):
    """Скачивает прокси из указанного URL"""
    try:
        async with session.get(url, timeout=15) as response:
            if response.status == 200:
                text = await response.text()
                proxies = []
                for line in text.split("\n"):
                    proxy = parse_proxy(line)
                    if proxy:
                        proxies.append(proxy)
                print(f"  ✅ {url.split('/')[-1]}: {len(proxies)} прокси")
                return proxies
            else:
                print(f"  ⚠️ {url.split('/')[-1]}: статус {response.status}")
                return []
    except asyncio.TimeoutError:
        print(f"  ⏰ {url.split('/')[-1]}: таймаут")
        return []
    except Exception as e:
        print(f"  ❌ {url.split('/')[-1]}: {str(e)[:50]}")
        return []


async def main():
    print("=" * 60)
    print(f"🔄 MTProto Proxy Checker v1.1")
    print(f"📅 {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"⏱️  Таймаут: {TIMEOUT} сек")
    print(f"📡 Источников: {len(SOURCES)}")
    print("=" * 60)

    # Шаг 1: Скачиваем прокси из всех источников
    print("\n📥 Загрузка прокси из источников...")
    async with aiohttp.ClientSession() as session:
        tasks = [fetch_proxies(session, url) for url in SOURCES]
        results = await asyncio.gather(*tasks)

    # Объединяем и удаляем дубликаты
    all_proxies = []
    seen = set()
    for proxies in results:
        for p in proxies:
            key = f"{p['server']}:{p['port']}"
            if key not in seen:
                seen.add(key)
                all_proxies.append(p)

    print(f"\n✅ Уникальных прокси после объединения: {len(all_proxies)}")

    if not all_proxies:
        print("❌ Не найдено ни одного прокси!")
        print("\n💡 Возможные причины:")
        print("   - Нет интернета")
        print("   - GitHub временно недоступен")
        print("   - Прокси-сервер блокирует доступ")
        return

    # Шаг 2: Проверяем прокси
    print(f"\n🔍 Проверка {len(all_proxies)} прокси (таймаут {TIMEOUT} сек)...")
    start_time = time.time()

    # Используем семафор для ограничения количества одновременных проверок
    semaphore = asyncio.Semaphore(MAX_CONCURRENT)

    async def check_with_limit(proxy):
        async with semaphore:
            return await check_proxy_simple(proxy)

    tasks = [check_with_limit(proxy) for proxy in all_proxies]
    results = await asyncio.gather(*tasks)

    elapsed = time.time() - start_time

    # Шаг 3: Фильтруем живые прокси
    alive = [r for r in results if r["status"] == "alive"]
    dead = [r for r in results if r["status"] == "dead"]

    print(f"\n📊 Результаты проверки:")
    print(f"   ✅ Живые: {len(alive)}")
    print(f"   ❌ Мёртвые: {len(dead)}")
    print(f"   ⏱️  Время проверки: {elapsed:.2f} сек")

    # Шаг 4: Сохраняем результаты
    if alive:
        # Формат для Telegram (tg://)
        with open("alive_proxies_tg.txt", "w") as f:
            for item in alive:
                p = item["proxy"]
                if p.get("secret"):
                    f.write(
                        f"tg://proxy?server={p['server']}&port={p['port']}&secret={p['secret']}\n"
                    )
                else:
                    f.write(f"tg://proxy?server={p['server']}&port={p['port']}\n")

        # Простой формат ip:port[:secret]
        with open("alive_proxies_simple.txt", "w") as f:
            for item in alive:
                p = item["proxy"]
                if p.get("secret"):
                    f.write(f"{p['server']}:{p['port']}:{p['secret']}\n")
                else:
                    f.write(f"{p['server']}:{p['port']}\n")

        print(f"\n💾 Сохранено:")
        print(f"   📄 alive_proxies_tg.txt — {len(alive)} прокси в формате tg://")
        print(f"   📄 alive_proxies_simple.txt — {len(alive)} прокси в формате ip:port")

        # Выводим первые 5 примеров
        print(f"\n📋 Примеры живых прокси (первые 5):")
        for i, item in enumerate(alive[:5]):
            p = item["proxy"]
            print(f"   {i+1}. {p['server']}:{p['port']}")
    else:
        print("\n❌ Нет живых прокси!")
        print("💡 Попробуйте:")
        print("   - Увеличить TIMEOUT в скрипте (например, до 10 секунд)")
        print("   - Запустить позже (списки обновляются каждые 12 часов)")
        print("   - Проверить интернет-соединение")

    print("\n" + "=" * 60)


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n\n⏹️  Прервано пользователем")
        sys.exit(0)
